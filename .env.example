# URL del proyecto: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Clave publicable (sb_publishable_... o la antigua "anon"). Puede llegar al navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOLO SERVIDOR. Clave secreta (sb_secret_...) o la antigua service_role.
# Ignora RLS: nunca le pongas el prefijo NEXT_PUBLIC_ ni la subas al repositorio.
SUPABASE_SECRET_KEY=

# El proyecto no tiene autenticación: en producción (next start) los endpoints de
# carga y lectura responden 403 salvo que se active esto. Protégelos antes de publicar.
# ETL_PERMITIR_SIN_AUTENTICACION=true
